# Firebase Web App configuration
VITE_FIREBASE_API_KEY=ضع_قيمة_apiKey_هنا
VITE_FIREBASE_AUTH_DOMAIN=اسم-المشروع.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=اسم-المشروع
VITE_FIREBASE_STORAGE_BUCKET=اسم-المشروع.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=ضع_القيمة_هنا
VITE_FIREBASE_APP_ID=ضع_القيمة_هنا

# Facebook UID أو بريد حساب المسؤول الوحيد
VITE_ADMIN_FACEBOOK_UID=ضع_Facebook_UID_الخاص_بك_هنا
VITE_ADMIN_EMAIL=اختياري_للتعرف_على_حسابك@example.com

# Optional: deployed HTTPS continuation URL; add its host to Firebase Authorized domains
VITE_FIREBASE_EMAIL_LINK_URL=
# Optional: custom Firebase Hosting link domain; leave unset to use the Firebase project default
VITE_FIREBASE_LINK_DOMAIN=
